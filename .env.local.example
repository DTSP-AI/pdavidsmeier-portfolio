OPENAI_API_KEY=sk-your-key-here

# Vercel Blob (used by /api/access-request to store signed NCNDAs).
# Auto-injected by `vercel env pull` once a Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# HMAC-SHA256 secret shared with the gated apps (deal-whisper-live,
# real-time-med-agent). Used to mint and verify access tokens minted
# after a successful NCNDA signature. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The same value MUST be set on every project that mints or verifies.
NCNDA_GATE_SECRET=replace-with-32-bytes-base64url

# Access-vetting routine (lib/access-vetting/routine.ts). When a visitor is
# NOT on the resume list, Rick collects name + email and the app fires a
# Claude Code routine that vets the person and pings Pete with approve/deny
# links. Create the routine at https://claude.ai/code/routines, add an API
# trigger, and paste the URL + token here. Unset = requests are stored but
# nobody is notified.
CLAUDE_ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_xxx/fire
CLAUDE_ROUTINE_FIRE_TOKEN=sk-ant-oat01-xxx

# Public origin used to build the approve/deny links in the notification.
# Falls back to the request host when unset.
NEXT_PUBLIC_SITE_URL=https://your-portfolio-domain.com

# MCP server (app/api/mcp/route.ts). Streamable HTTP at /api/mcp.
# MCP_ADMIN_TOKEN: full surface incl. approve/deny. MCP_READ_TOKEN: public
# portfolio tools only. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Claude.ai: Settings > Connectors > Add custom connector > URL
#   https://<domain>/api/mcp, auth = fixed header "Authorization: Bearer <token>".
MCP_ADMIN_TOKEN=replace-me
MCP_READ_TOKEN=replace-me
